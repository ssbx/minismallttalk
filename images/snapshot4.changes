t 	aFilePage pageNumber = 0 may or may not exist in some file systems. The pageNumber may	be used to compute a byte range to be read, or to lookup a disk address in a table.	In a file system where pages are linked, aFilePage may contain the address	of the next page and may help reveal lastPageNumber."	(self doCommand: 0 name: nil page: page error:'read:') ifFalse: [^nil].	^page!write: page	| returnPage |	self doCommand: 1 name: nil page: page error:'write:'.	returnPage _ page.	((page lastPage) and: [page isFull])	  ifTrue: ["last page can't be full, so glue on another page"		returnPage _ self initPageNumber: 0.		returnPage reinitialize.		returnPage pageNumber: (lastPageNumber _ page pageNumber + 1)].	readWrite _ Read + Write.	^returnPage! !!PosixFileDirectory methodsFor: 'private'!doPrimitive: code arg1: arg1 arg2: arg2	<primitive: 131>! !!PosixFileDirectory methodsFor: 'enumerating'!do: aBlock 	| files |	files _ (self fileNames collect: [ : aFileName | self initFileName: aFileName  ]).	(ReadStream on:files) do: aBlock! !!PosixFileDirectory methodsFor: 'removing'!removeOld: aFile	self doPrimitive: 1 arg1: aFile fileName arg2: nil! !!PosixFileDirectory methodsFor: 'adding'!add: aFile 	^self addNew: aFile!addNew: aFile 	| fd |	fd _ self doPrimitive: 0 arg1: aFile fileName arg2: nil.	aFile fd: fd.	aFile readWrite: Write.	^aFile! !!PosixFileDirectory methodsFor: 'file accessing'!rename: aFile newName: newFileName	self doPrimitive: 2 arg1: newFileName arg2: aFile! !Smalltalk condenseChanges!'----SNAPSHOT----'!'----SNAPSHOT----'!Smalltalk!SourceFiles!!ScrollController methodsFor: 'basic control sequence'!controlInitialize	"The scrollbar has a two-pixel border, and for alignment it assumes that this sub-view	has a one-pixel border and shares another one-pixel border from its neighbor/super view"	super controlInitialize.	scrollBar region: (0 @ 0 extent: 32 @ (view displayBox height + 2)).	marker region: self computeMarkerRegion.	scrollBar _ scrollBar align: scrollBar topRight with: view displayBox topLeft - (0@1).	marker _ marker align: marker topCenter with: scrollBar inside topCenter.	savedArea _ Form fromDisplay: scrollBar.	scrollBar displayOn: Display.	self moveMarker! !!ScrollController methodsFor: 'basic control sequence'!controlInitialize	"The scrollbar has a two-pixel border, and for alignment it assumes that this sub-view	has a one-pixel border and shares another one-pixel border from its neighbor/super view"	super controlInitialize.	scrollBar region: (0 @ 0 extent: 32 @ (view displayBox height + 2)).	marker region: self computeMarkerRegion.	scrollBar _ scrollBar align: scrollBar topRight with: view displayBox topLeft - (0@1).	marker _ marker align: marker topCenter with: scrollBar inside topCenter.	savedArea _ Form fromDisplay: scrollBar.	scrollBar displayOn: Display.	self moveMarker! !DisplayScreen displayExtent: 1024@808.!DisplayScreen displayExtent: 1024@808.!2.3 + 1.3!Object subclass: #TestSeb	instanceVariableNames: 'instVarName1 instVarName2'	classVariableNames: 'ClassVarName1 ClassVarName2'	poolDictionaries: ''	category: 'Test'!TestSeb organization addCategory: #prim before: nil!!TestSeb methodsFor: 'prim'!primTestSeb  ^self! !!TestSeb methodsFor: 'prim'!primTestSeb      <primitive: 140>! !TestSeb new primTestSeb!'----SNAPSHOT----'!DisplayScreen displayExtent:  640@480.!'----SNAPSHOT----'!DisplayScreen displayExtent:  640@480.!DisplayScreen displayExtent:  640@480.!DisplayScreen displayExtent:  620@480.!DisplayScreen displayExtent: 900@750.!DisplayScreen displayExtent: 900@650.!DisplayScreen displayExtent: 900@350.!DisplayScreen displayExtent: 900@550.!DisplayScreen displayExtent: 930@550.!DisplayScreen displayExtent: 960@560.!DisplayScreen displayExtent: 955@560.!DisplayScreen displayExtent: 958@560.!DisplayScreen displayExtent: 960@560.!DisplayScreen displayExtent: 958@560.!