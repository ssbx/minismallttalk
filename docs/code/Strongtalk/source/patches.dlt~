! (Delta mirrorFor: #DeltaPrimitiveGenerator) methodsFor: 'private file out' !
fileOut
	| file |
	file := (FilePath for: 'prims.inc') charOutputStream. 
	[ self fileOutOn: file ] ensure: [ file close ].
! !

